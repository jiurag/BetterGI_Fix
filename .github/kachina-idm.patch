+/// the finished output fails validation, so known-good partials are retained
+/// across cancellation and network failures.
+pub fn discard_resume(keys: &[String]) {
+    let Ok(dl_dir) = CURRENT.try_with(|ctx| ctx.session.dl_dir.clone()) else {
+        return;
+    };
+    for key in keys.iter().filter(|key| valid_resume_key(key)) {
+        let dir = Path::new(&dl_dir).join("resume").join(key);
+        if let Err(err) = std::fs::remove_dir_all(&dir) {
+            if err.kind() != std::io::ErrorKind::NotFound {
+                tracing::warn!("remove resume {} failed: {err}", dir.display());
+            }
+        }
+    }
+}
+
+pub fn prune_resume(dl_dir: &Path) {
+    let root = dl_dir.join("resume");
+    let Ok(entries) = std::fs::read_dir(&root) else {
+        return;
+    };
+    let oldest = SystemTime::now().checked_sub(RESUME_MAX_AGE);
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let expired = oldest.is_some_and(|limit| {
+            entry
+                .metadata()
+                .and_then(|meta| meta.modified())
+                .map(|modified| modified < limit)
+                .unwrap_or(true)
+        });
+        if expired {
+            let _ = std::fs::remove_dir_all(path);
+        }
+    }
+}
