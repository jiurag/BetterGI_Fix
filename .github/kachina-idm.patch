+/// Stable range-download identity. Signed URLs and temporary staging paths are
+/// intentionally excluded, so a later launch can find the same partial range.
+fn download_resume_key(content_hash: &str, parts: &[(u64, u64)]) -> String {
+    use sha2::Digest;
+    let mut digest = sha2::Sha256::new();
+    digest.update(b"kachina-resume-v1\n");
+    digest.update(content_hash.as_bytes());
+    for (start, len) in parts {
+        digest.update(b"\n");
+        digest.update(start.to_le_bytes());
+        digest.update(len.to_le_bytes());
+    }
+    hex::encode(&digest.finalize()[..16])
+}
